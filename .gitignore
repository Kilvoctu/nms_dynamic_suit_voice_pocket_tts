# Runtime state: engine cache and personal user data (structure tracked where
# noted, contents never overwritten by updates).
state/cache/
state/user/*
!state/user/.gitkeep
!state/user/pocket_voices
state/user/pocket_voices/*
!state/user/pocket_voices/.gitkeep

# Ignore all archived and stored material.
archived/
extras_put_in_mods_folder/

# Downloaded external tool binaries (fetched by setup into bin/).
/state/bin/*.exe

# But keep icons/images
!assets/**/*.png
!assets/**/*.ico

state/cache/sandbox_raw.wav
state/cache/sandbox_processed.wav

